        {
          "expr": "rate(search_trends_antifraud_downweighted_total[1m])",
          "legendFormat": "downweighted/s"
        }
      ]
    },
    {
      "title": "Stoplist dropped",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
