  "links": [],
  "panels": [
    {
      "title": "HTTP RPS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(search_trends_http_requests_total[1m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "title": "HTTP latency p50/p95/p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(search_trends_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(search_trends_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(search_trends_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "HTTP error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "sum(rate(search_trends_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(search_trends_http_requests_total[1m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "title": "Ingestion events/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(search_trends_events_total{outcome=\"accepted\"}[1m]))",
          "legendFormat": "accepted"
        }
      ]
    },
    {
      "title": "Dropped events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "rate(search_trends_events_dropped_total[1m])",
          "legendFormat": "dropped/s"
        }
      ]
    },
    {
